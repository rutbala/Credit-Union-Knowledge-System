# Copy to .env and fill in. Real environment variables take precedence over this file.
# Everything here is optional: with no .env the system runs fully deterministic (no API calls).

# Optional LLM fallback (submission/kb/llm.py). off = deterministic answers only (default).
KB_LLM=off
# fallback = LLM answers only questions the rules are unsure about; polish = reword every answer; both.
KB_LLM_MODE=fallback
# Seconds per LLM call before keeping the deterministic answer (speed is scored per answer).
KB_LLM_TIMEOUT=3

# Provider 1: Claude (needs `pip install anthropic`). Used first when set.
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_MODEL=claude-haiku-5-5

# Provider 2: Azure OpenAI Responses API (standard library only).
AZURE_OPENAI_API_KEY=
# The deployment name on the Azure resource (sent as the Responses API "model" field).
AZURE_OPENAI_MODEL=
AZURE_OPENAI_ENDPOINT=https://llm-model-test-hars.services.ai.azure.com/openai/v1/responses
