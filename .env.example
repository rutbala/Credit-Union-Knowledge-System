# Copy to .env and fill in. Real environment variables take precedence over this file.

# Optional LLM writer (submission/kb/llm.py): rewords answers via Azure OpenAI Responses API.
# on = use the LLM writer; off = deterministic answers only (for A/B scoring). Default off.
KB_LLM=off
AZURE_OPENAI_API_KEY=
# The deployment name on the Azure resource (sent as the Responses API "model" field).
AZURE_OPENAI_MODEL=
AZURE_OPENAI_ENDPOINT=https://llm-model-test-hars.services.ai.azure.com/openai/v1/responses
# Seconds per LLM call before falling back to the deterministic answer.
KB_LLM_TIMEOUT=8

# Only for `harness/run_eval.py --judge` (the scorer's optional Claude judge).
# ANTHROPIC_API_KEY=your-anthropic-key
